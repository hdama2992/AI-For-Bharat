# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Bedrock Model IDs
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_HAIKU_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Bhashini API (Speech-to-Text, Text-to-Speech, Translation)
BHASHINI_USER_ID=your_user_id
BHASHINI_API_KEY=your_api_key

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (set to true for production)
USE_DYNAMODB=false
DYNAMODB_TABLE_PREFIX=vikasgpt_

# App
DEBUG=true

